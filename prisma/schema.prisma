generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  name               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  documents          StudyDocument[]
  flashcardSets      FlashcardSet[]
  quizzes            Quiz[]
  quizAttempts       QuizAttempt[]
  topicProgress      UserTopicProgress[]
}

model StudyDocument {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  title              String
  originalFileName   String?
  mimeType           String?
  storageUrl         String?
  contentText        String?
  status             DocumentStatus      @default(PROCESSING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics             DocumentTopic[]
  flashcardSets      FlashcardSet[]
  quizzes            Quiz[]

  @@index([userId, createdAt])
  @@index([status])
}

model Topic {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @unique
  documents          DocumentTopic[]
  flashcards         FlashcardTopic[]
  progress           UserTopicProgress[]
}

model DocumentTopic {
  documentId         String              @db.Uuid
  topicId            String              @db.Uuid
  document           StudyDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  topic              Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([documentId, topicId])
  @@index([topicId])
}

model FlashcardSet {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  documentId         String?             @db.Uuid
  title              String
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  document           StudyDocument?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  flashcards         Flashcard[]

  @@index([userId, createdAt])
  @@index([documentId])
}

model Flashcard {
  id                 String              @id @default(uuid()) @db.Uuid
  setId              String              @db.Uuid
  question           String
  answer             String
  difficulty         FlashcardDifficulty
  explanation        String?
  position           Int
  createdAt          DateTime            @default(now())
  set                FlashcardSet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  topics             FlashcardTopic[]

  @@unique([setId, position])
  @@index([setId])
}

model FlashcardTopic {
  flashcardId        String              @db.Uuid
  topicId            String              @db.Uuid
  flashcard          Flashcard           @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  topic              Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([flashcardId, topicId])
  @@index([topicId])
}

model Quiz {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  documentId         String?             @db.Uuid
  title              String
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  document           StudyDocument?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  questions          QuizQuestion[]
  attempts           QuizAttempt[]

  @@index([userId, createdAt])
  @@index([documentId])
}

model QuizQuestion {
  id                 String              @id @default(uuid()) @db.Uuid
  quizId             String              @db.Uuid
  prompt             String
  explanation        String?
  topic              String
  difficulty         FlashcardDifficulty
  position           Int
  quiz               Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options            QuizOption[]
  answers            QuizAnswer[]

  @@unique([quizId, position])
  @@index([quizId])
}

model QuizOption {
  id                 String              @id @default(uuid()) @db.Uuid
  questionId         String              @db.Uuid
  text               String
  isCorrect          Boolean             @default(false)
  question           QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedInAnswers  QuizAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id                 String              @id @default(uuid()) @db.Uuid
  quizId             String              @db.Uuid
  userId             String              @db.Uuid
  startedAt          DateTime            @default(now())
  completedAt        DateTime?
  score              Decimal?            @db.Decimal(5, 2)
  quiz               Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers            QuizAnswer[]

  @@index([userId, startedAt])
  @@index([quizId, startedAt])
}

model QuizAnswer {
  id                 String              @id @default(uuid()) @db.Uuid
  attemptId          String              @db.Uuid
  questionId         String              @db.Uuid
  selectedOptionId   String?             @db.Uuid
  answerText         String?
  isCorrect          Boolean?
  answeredAt         DateTime            @default(now())
  attempt            QuizAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question           QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption     QuizOption?         @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([selectedOptionId])
}

model UserTopicProgress {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  topicId            String              @db.Uuid
  correctAnswers     Int                 @default(0)
  incorrectAnswers   Int                 @default(0)
  masteryScore       Decimal?            @db.Decimal(5, 2)
  lastReviewedAt     DateTime?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic              Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, masteryScore])
  @@index([topicId])
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum FlashcardDifficulty {
  easy
  medium
  hard
}